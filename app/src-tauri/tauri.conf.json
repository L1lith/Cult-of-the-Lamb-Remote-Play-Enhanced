{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Remote Play Enhanced",
  "version": "0.1.0",
  "identifier": "com.l1lith.cotl.remoteplayenhanced",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4321",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Remote Play Enhanced",
        "width": 1120,
        "height": 820,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "resources": [
      "resources/*"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/L1lith/Cult-of-the-Lamb-Remote-Play-Enhanced/releases/latest/download/latest.json"
      ],
      "pubkey": "REPLACE_WITH_TAURI_UPDATER_PUBLIC_KEY"
    }
  }
}
