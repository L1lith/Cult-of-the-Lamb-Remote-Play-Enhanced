<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unity Mono (Cult of the Lamb) uses the .NET Framework profile. -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RemotePlayEnhanced</AssemblyName>
    <RootNamespace>RemotePlayEnhanced</RootNamespace>
    <Version>0.2.0</Version>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <!-- Game assemblies are still not referenced: every game type is resolved
         by name at runtime, so CI stays free of copyrighted DLLs. HarmonyX is
         used only for AccessTools and is already a BepInEx dependency. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepInEx.Core" Version="5.4.21" />
    <PackageReference Include="HarmonyX" Version="2.10.2" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
