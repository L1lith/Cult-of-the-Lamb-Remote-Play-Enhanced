<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Unity Mono (Cult of the Lamb) uses the .NET Framework profile. -->
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>RemotePlayEnhanced</AssemblyName>
    <RootNamespace>RemotePlayEnhanced</RootNamespace>
    <Version>0.4.0</Version>
    <LangVersion>7.3</LangVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Game assemblies are still not referenced: every game type is resolved
         by name at runtime, so CI never needs copyrighted DLLs. UnityEngine
         reference assemblies come from the public UnityEngine.Modules package;
         they are compile-time stubs only. -->
  </PropertyGroup>

  <ItemGroup>
    <!-- The bootstrap is a separate assembly; keep its sources and generated
         files out of the mod's default glob. -->
    <Compile Remove="bootstrap/**" />
    <None Remove="bootstrap/**" />
  </ItemGroup>

  <ItemGroup>
    <!-- Original Harmony 2, not HarmonyX. The mod is loaded by its own
         Doorstop bootstrap, so no BepInEx assembly is referenced. -->
    <PackageReference Include="Lib.Harmony" Version="2.4.3" />
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" IncludeAssets="compile" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
